# Copy this file to .env, or just run `npm run setup` and it will create .env for you.
# Never commit .env: it holds your database password. (.env is in .gitignore.)

# Your Neon connection string: Neon → Connect → "Show password" → Copy snippet.
# Keep "Connection pooling" switched on in Neon (the host then contains "-pooler").
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR-NEON-HOST-pooler.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Password for the admin panel at /admin (at least 8 characters). `npm run setup` generates one.
ADMIN_PASSWORD="change-me"
